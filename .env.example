# Database
DATABASE_URL=mysql://user:password@localhost:3306/pdits
DEBUG_DB=false

# Redis
REDIS_URL=redis://:password@localhost:6379
DISABLE_REDIS=false

# JWT
JWT_SECRET=your-jwt-secret-key-min-64-characters-long-for-production
JWT_REFRESH_SECRET=your-refresh-secret-key-min-64-characters-long-for-production
JWT_ACCESS_EXPIRY=5h
JWT_REFRESH_EXPIRY=7d

# Web Push (VAPID)
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:admin@yourdomain.com

# App Configuration
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:5173

# CORS
CORS_ORIGIN=http://localhost:5173
