// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============================================
// USER & AUTHENTICATION
// ============================================

enum UserRole {
  SUPER_ADMIN
  ADMIN
  USER
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      UserRole @default(USER)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  auditLogs     AuditLog[]
  notifications Notification[]
  calculationHistories CalculationHistory[]
  fgStocks      FGStock[]
  fgStockHistory FGStockHistory[]
  wips          WIP[]
  cycleAuditLogs CycleAuditLog[]

  @@index([email])
  @@index([role])
  @@map("users")
}

// ============================================
// MASTER DATA
// ============================================

model Item {
  id        String   @id @default(cuid())
  partNumber  String   @unique
  itemName  String
  unit      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  dailySchedules  DailySchedule[]
  weeklySchedules WeeklySchedule[]
  fgStocks        FGStock[]
  fgStockHistory  FGStockHistory[]
  wips            WIP[]
  masterCartons   MasterCarton[]

  @@index([partNumber])
  @@index([itemName])
  @@map("items")
}

// Riwayat pergerakan stok barang jadi.
// Model ini sempat hilang dari schema padahal route `fgStockHistory.ts` masih
// memakainya, sehingga build gagal begitu Prisma Client di-generate ulang.
model FGStockHistory {
  id        String   @id @default(cuid())
  itemId    String
  inQty     Float    @default(0)
  outQty    Float    @default(0)
  balance   Float
  type      String
  date      DateTime @db.Date
  notes     String?  @db.Text
  createdBy String
  createdAt DateTime @default(now())

  // Relations
  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)
  user User @relation(fields: [createdBy], references: [id])

  @@index([itemId])
  @@index([date])
  @@map("fg_stock_history")
}

model MasterCarton {
  id             String   @id @default(cuid())
  cartonCode     String   @unique
  toyNameItemId  String // Reference to Item (Toy Name)
  partNumberCode String // Part number that belongs to this master carton
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  toyNameItem Item @relation(fields: [toyNameItemId], references: [id], onDelete: Cascade)

  @@index([toyNameItemId])
  @@index([partNumberCode])
  @@map("master_cartons")
}

// ============================================
// DEMAND / SCHEDULE
// ============================================

model DailySchedule {
  id        String   @id @default(cuid())
  date      DateTime @db.Date
  shift     Int // 1, 2, or 3
  itemId    String
  quantity  Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([date, shift, itemId])
  @@index([date, shift])
  @@index([itemId])
  @@map("daily_schedules")
}

model WeeklySchedule {
  id            String   @id @default(cuid())
  year          Int
  weekNumber    Int // 1-26
  weekStartDate DateTime @db.Date
  weekEndDate   DateTime @db.Date
  itemId        String
  quantity      Float
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([year, weekNumber, itemId])
  @@index([year, weekNumber])
  @@index([itemId])
  @@map("weekly_schedules")
}

// ============================================
// STOCK & INVENTORY
// ============================================

model FGStock {
  id        String    @id @default(cuid())
  itemId    String    @unique // Unique karena hanya 1 record per item (overwrite)
  quantity  Float
  date      DateTime  @db.Date
  shift     Int? // Optional
  notes     String?   @db.Text
  updatedBy String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Relations
  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)
  user User @relation(fields: [updatedBy], references: [id])

  @@index([itemId])
  @@index([date])
  @@map("fg_stocks")
}

// ============================================
// WORK IN PROGRESS (WIP)
// ============================================

enum WIPStatus {
  IN_PROGRESS
  ON_HOLD
  DELAYED
  COMPLETED
}

model WIP {
  id              String    @id @default(cuid())
  itemId          String
  location        String // Mesin-01, Assembly Line, etc.
  quantity        Float
  progressPercent Int       @default(0) // 0-100
  date            DateTime  @db.Date
  shift           Int // 1, 2, or 3
  status          WIPStatus @default(IN_PROGRESS)
  notes           String?   @db.Text
  updatedBy       String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)
  user User @relation(fields: [updatedBy], references: [id])

  @@unique([itemId, location]) // Unique per item + location (overwrite)
  @@index([itemId])
  @@index([location])
  @@index([status])
  @@index([date, shift])
  @@map("wips")
}

// ============================================
// AUDIT LOG
// ============================================

enum AuditAction {
  CREATE
  UPDATE
  DELETE
}

model AuditLog {
  id         String      @id @default(cuid())
  userId     String
  action     AuditAction
  entityType String // "FGStock", "WIP", "DailySchedule", etc.
  entityId   String
  dataBefore Json? // Data sebelum perubahan
  dataAfter  Json? // Data setelah perubahan
  notes      String?     @db.Text
  createdAt  DateTime    @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ============================================
// NOTIFICATIONS
// ============================================

enum NotificationType {
  SHORTAGE
  DELAY
  STALE_DATA
  INFO
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String           @db.Text
  itemCode  String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}

// ============================================
// HOTLIST
// ============================================

model Hotlist {
  id           String    @id @default(cuid())
  partNumber   String    @unique
  date         DateTime  @db.Date
  previousDate DateTime? @db.Date
  biTotal      Float
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([partNumber])
  @@index([date])
  @@map("hotlists")
}

// ============================================
// STOCK RAW MATERIAL
// ============================================

model StockRawMaterial {
  id        String   @id @default(cuid())
  itemDesc  String
  date      DateTime @db.Date
  supplier  String?
  qty       Float
  unit      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
  @@map("stock_raw_materials")
}

// ============================================
// OUTSTANDING PO
// ============================================

model OutstandingPO {
  id               String   @id @default(cuid())
  planReceivedDate DateTime @db.Date
  supplierName     String
  itemDesc         String
  qtyOrder         Float
  qtyOrderUnit     String   // "kg", "rim", "sheets"
  qtyDelivered     Float
  qtyDeliveredUnit String   // "kg", "rim", "sheets"
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([planReceivedDate])
  @@map("outstanding_pos")
}

// ============================================
// NPOF MATERIALS
// ============================================

model NpofMaterial {
  id              String    @id @default(cuid())
  npofId          Int
  partNumber      String
  productName     String
  material        String?
  gramatur        String?
  supplier        String?
  sheetedSize     String?
  formulaMaterial String?   @db.Text
  ups             String?
  isEdited        Boolean   @default(false)
  lastSyncedAt    DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([npofId, partNumber])
  @@index([npofId])
  @@index([partNumber])
  @@map("npof_materials")
}

// Immutable monthly snapshots of material calculations and their source data.
model CalculationHistory {
  id             String   @id @default(cuid())
  monthKey       String   // YYYY-MM folder key
  periodStartDate DateTime @db.Date
  periodEndDate   DateTime @db.Date
  periodWeeks     Int
  calculatedAt    DateTime
  savedAt         DateTime @default(now())
  savedBy         String
  resultSnapshot  Json

  user    User @relation(fields: [savedBy], references: [id])
  sources CalculationSourceSnapshot[]

  @@index([monthKey])
  @@index([savedAt])
  @@map("calculation_histories")
}

model CalculationSourceSnapshot {
  id          String   @id @default(cuid())
  historyId   String
  sourceType  String   // MRP, NPOF, StockRawMaterial, WIP, HOTLIST, OutstandingPO
  dataSnapshot Json
  createdAt   DateTime @default(now())

  history CalculationHistory @relation(fields: [historyId], references: [id], onDelete: Cascade)

  @@unique([historyId, sourceType])
  @@index([sourceType])
  @@map("calculation_source_snapshots")
}

// ============================================
// PLANNING CYCLE (Material Planning)
// ============================================
// Satu cycle = satu periode bulanan yang TERISOLASI penuh dari cycle lain.
// Semua tabel data wajib punya cycleId (NOT NULL) dan semua @@unique SELALU
// diawali cycleId, supaya tidak mungkin ada unique global yang bocor antar periode.

enum CycleStatus {
  DRAFT // data sedang disiapkan, belum dihitung
  CALCULATED // minimal sudah dihitung sekali (TETAP boleh diedit)
}

model PlanningCycle {
  id String @id @default(cuid())

  // ── Identitas BERBASIS BATCH UPLOAD, bukan tanggal di dalam data ──
  uploadMonth String // "2026-09" — otomatis dari waktu upload
  label       String @unique // "September 2026" — otomatis, bisa diedit
  status      CycleStatus @default(DRAFT)

  // ── Metadata deskriptif dari file MRP (untuk tampilan & perhitungan) ──
  mrpStartDate DateTime @db.Date
  mrpEndDate   DateTime @db.Date
  weekCount    Int      @default(26)

  // ── Jejak waktu ──
  firstUploadedAt    DateTime  @default(now())
  lastUploadedAt     DateTime  @default(now())
  lastDataChangeAt   DateTime  @default(now())
  calculatedAt       DateTime?
  calculatedBy       String?
  calculatedRunCount Int       @default(0)

  // ── Kunci manual (opsional, default OFF) ──
  isLocked Boolean   @default(false)
  lockedAt DateTime?
  lockedBy String?
  lockNote String?   @db.Text

  // ── Retensi 18 bulan ──
  retentionDueAt      DateTime?
  retentionNotifiedAt DateTime?

  notes     String?  @db.Text
  createdAt DateTime @default(now())
  createdBy String

  mrpWeeks  CycleMRPWeek[]
  hotlists  CycleHotlist[]
  stocks    CycleStockRM[]
  pos       CycleOutstandingPO[]
  wips      CycleWIP[]
  uploads   CycleSourceUpload[]
  results   CycleResult[]
  auditLogs CycleAuditLog[]
  // Catatan: TIDAK ada relasi ke NPOF — dipakai bersama semua periode.

  @@unique([uploadMonth])
  @@index([status])
  @@index([createdAt])
  @@map("planning_cycles")
}

// Jejak setiap upload (menjawab "kapan data diupload").
model CycleSourceUpload {
  id         String   @id @default(cuid())
  cycleId    String
  sourceType String // MRP | HOTLIST | STOCK_RM | OUTSTANDING_PO | WIP
  fileName   String?
  rowCount   Int      @default(0)
  mode       String? // replace | append (hanya di dalam cycle ini)
  uploadedAt DateTime @default(now())
  uploadedBy String

  cycle PlanningCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  @@index([cycleId, sourceType])
  @@index([uploadedAt])
  @@map("cycle_source_uploads")
}

// MRP 26 minggu. weekNumber 1..26 relatif terhadap file MRP yang diupload.
model CycleMRPWeek {
  id            String   @id @default(cuid())
  cycleId       String
  partNumber    String
  description   String?
  year          Int
  weekNumber    Int
  weekStartDate DateTime @db.Date
  weekEndDate   DateTime @db.Date
  quantity      Float

  cycle PlanningCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  @@unique([cycleId, partNumber, year, weekNumber])
  @@index([cycleId, weekStartDate])
  @@index([cycleId, partNumber])
  @@map("cycle_mrp_weeks")
}

model CycleHotlist {
  id         String @id @default(cuid())
  cycleId    String
  partNumber String
  biTotal    Float

  cycle PlanningCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  @@unique([cycleId, partNumber])
  @@map("cycle_hotlists")
}

// Stock Raw Material — SEMUA lot disimpan, bukan hanya yang terbaru.
model CycleStockRM {
  id       String   @id @default(cuid())
  cycleId  String
  itemDesc String
  supplier String?
  qty      Float
  unit     String
  date     DateTime @db.Date

  cycle PlanningCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  @@index([cycleId, itemDesc, supplier])
  @@map("cycle_stock_rm")
}

model CycleOutstandingPO {
  id               String   @id @default(cuid())
  cycleId          String
  itemDesc         String
  supplierName     String
  qtyOrder         Float
  qtyOrderUnit     String
  qtyDelivered     Float
  qtyDeliveredUnit String
  planReceivedDate DateTime @db.Date

  cycle PlanningCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  @@index([cycleId, itemDesc, supplierName])
  @@map("cycle_outstanding_po")
}

model CycleWIP {
  id         String @id @default(cuid())
  cycleId    String
  partNumber String
  location   String
  quantity   Float

  cycle PlanningCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  @@unique([cycleId, partNumber, location])
  @@map("cycle_wips")
}

// Hasil kalkulasi: SATU BARIS PER RUN (mendukung simpan versi).
model CycleResult {
  id              String   @id @default(cuid())
  cycleId         String
  runNumber       Int
  periodStartDate DateTime @db.Date
  periodEndDate   DateTime @db.Date
  periodWeeks     Int
  calculatedAt    DateTime
  calculatedBy    String
  /// Nilai PlanningCycle.lastDataChangeAt saat perhitungan dijalankan.
  /// Kalau lastDataChangeAt > dataVersionAt berarti hasil sudah STALE.
  dataVersionAt   DateTime

  /// Tepat satu baris per periode yang isCurrent = true.
  isCurrent       Boolean  @default(false)
  /// isSaved = true -> baris ini TIDAK dihapus saat ada perhitungan baru.
  isSaved         Boolean  @default(false)
  savedNote       String?  @db.Text

  resultSnapshot  Json // groups + weeklyMatrix 26 kolom
  summarySnapshot Json?

  cycle PlanningCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  @@unique([cycleId, runNumber])
  @@index([cycleId, isCurrent])
  @@index([cycleId, isSaved])
  @@map("cycle_results")
}

// Jejak perubahan di dalam periode (siapa mengubah apa).
model CycleAuditLog {
  id         String      @id @default(cuid())
  cycleId    String
  userId     String
  action     AuditAction
  sourceType String? // MRP | HOTLIST | STOCK_RM | OUTSTANDING_PO | WIP | CYCLE
  entityType String
  entityId   String?
  dataBefore Json?
  dataAfter  Json?
  notes      String?     @db.Text
  createdAt  DateTime    @default(now())

  cycle PlanningCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  user  User          @relation(fields: [userId], references: [id])

  @@index([cycleId, createdAt])
  @@index([cycleId, sourceType])
  @@index([userId])
  @@map("cycle_audit_logs")
}
